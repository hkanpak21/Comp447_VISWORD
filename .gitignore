# Data caches and run outputs (regenerated by prefetch / training).
# Leading slashes anchor these to the repo root so they don't shadow
# src/visword/data/ or anything else named "data" / "runs" in the tree.
/data/
/runs/

# Vendored SALAD repo (regenerated by scripts/vendor_salad.sh)
/third_party/salad/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Local env / IDE
.venv/
.env
.vscode/
.idea/

# Coverage / pytest
.coverage
.pytest_cache/
htmlcov/
